APP_NAME=fastapi-gemini-async-api
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

GEMINI_API_KEY=replace_me
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Optional: enable local Ollama by setting these values.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=gemma3

REQUEST_TIMEOUT_SECONDS=30
MAX_INPUT_CHARS=16000
MAX_OUTPUT_TOKENS_LIMIT=2048
DEFAULT_MAX_OUTPUT_TOKENS=512
MAX_CONCURRENT_PROVIDER_CALLS=10

# Sales digitization settings
GEMINI_VISION_MODEL=gemini-2.0-flash
MAX_IMAGE_BYTES=10485760
VISION_TIMEOUT_SECONDS=90

# Google Sheets integration (optional — omit to disable /v1/export-to-sheets)
# Paste the entire contents of your service-account JSON key file as a single line:
# GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"..."}
GOOGLE_SHEETS_DEFAULT_TITLE=Digitized Sales Records
